# Copy to infra/.env and change the values locally. Never commit infra/.env.
#   cp infra/.env.example infra/.env

# PostgreSQL password for the Moodle database
MOODLE_DB_PASSWORD=change-me

# Moodle admin login (username: admin)
MOODLE_ADMIN_PASSWORD=Change-me-1!

# Port and URL Moodle is served on. Change both together.
MOODLE_PORT=8000
MOODLE_WWWROOT=http://localhost:8000

# REST token for the golden master tests (#12). 32 lowercase hex chars: `openssl rand -hex 16`.
# Leave empty to let Moodle generate one (printed in `docker compose logs moodle`).
MOODLE_WS_TOKEN=

# Password for all sample users (teachers and students) created by infra/sample-data/load.sh
SAMPLE_USER_PASSWORD=Sample-pass-1!
