# Copy to .env and fill in locally. Never commit .env.
POSTGRES_USER=fig
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fig
JWT_SECRET=change-me
MOODLE_URL=http://localhost:8000
# Shared password of the temporary sample users of the backend API (student1..5, teacher1, teacher2, admin)
SAMPLE_USER_PASSWORD=change-me
# Folder of uploaded file contents (default backend/data/files when run from backend/)
FIG_FILES_ROOT=./data/files
